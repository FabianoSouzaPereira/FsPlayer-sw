{
  "name": "FsPlayer",
  "version": "0.1.0",
  "summary": "Modern video player framework for iOS.",
  "description": "FsPlayer is a modular and modern video playback framework\nbuilt with Swift and SwiftUI.",
  "homepage": "https://github.com/FabianoSouzaPereira/FsPlayer-sw",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "Fabiano Pereira": "jeovajire2003@gmail.com"
  },
  "platforms": {
    "ios": "16.2"
  },
  "source": {
    "git": "https://github.com/FabianoSouzaPereira/FsPlayer-sw.git",
    "tag": "0.1.0"
  },
  "swift_versions": "5.10",
  "source_files": "Sources/FsPlayer/**/*.{swift}",
  "frameworks": [
    "AVFoundation",
    "UIKit"
  ],
  "pod_target_xcconfig": {
    "ENABLE_BITCODE": "NO",
    "BUILD_LIBRARY_FOR_DISTRIBUTION": "YES",
    "SWIFT_VERSION": "5.10",
    "IPHONEOS_DEPLOYMENT_TARGET": "16.2",
    "EXCLUDED_ARCHS[sdk=iphonesimulator*]": "arm64"
  },
  "default_subspecs": "Debug",
  "subspecs": [
    {
      "name": "Release",
      "vendored_frameworks": "FsPlayer.xcframework",
      "resources": "Sources/FsPlayer/Resources/**/*.{plist,xib,json,ttf,xcassets,strings,xcassets}",
      "dependencies": {}
    },
    {
      "name": "Debug",
      "vendored_frameworks": "FsPlayer.xcframework",
      "resources": "Sources/FsPlayer/Resources/**/*.{swift,plist,xib,json,ttf,xcassets,strings,xcassets}",
      "dependencies": {}
    }
  ],
  "swift_version": "5.10"
}
