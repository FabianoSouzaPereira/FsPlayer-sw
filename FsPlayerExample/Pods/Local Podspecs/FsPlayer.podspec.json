{
  "name": "FSPlayer",
  "version": "0.1.0",
  "summary": "Modern video player framework for iOs.",
  "description": "FSPlayer is a modular and modern video player framework built with Swift and SwiftUI. \nIt provides a simple API for playback control.",
  "homepage": "https://github.com/FabianoSouzaPereira/FsPlayer-sw",
  "license": {
    "type": "MIT",
    "file": "LICENSE"
  },
  "authors": {
    "Fabiano Souza Pereira": "jeovajire2003@gmail.com"
  },
  "platforms": {
    "ios": "16.2"
  },
  "source": {
    "git": "https://github.com/FabianoSouzaPereira/FsPlayer-sw.git",
    "tag": "0.1.0"
  },
  "swift_versions": "5.10",
  "frameworks": [
    "Foundation",
    "UIKit",
    "AVFoundation",
    "SwiftUI",
    "Combine"
  ],
  "default_subspecs": "Debug",
  "subspecs": [
    {
      "name": "Binary",
      "vendored_frameworks": "FSPlayer.xcframework",
      "resources": "Sources/FSPlayer/Resources/**/*.{plist,xib,json,ttf,xcassets,strings}"
    },
    {
      "name": "Debug",
      "source_files": "Sources/FSPlayer/**/*.swift",
      "resources": "Sources/FSPlayer/Resources/**/*.{plist,xib,json,ttf,xcassets,strings}"
    }
  ],
  "swift_version": "5.10"
}
